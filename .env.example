# Variáveis do projeto. Este arquivo lista apenas os NOMES — nenhum valor.
# O repositório é público: chave, token, credencial e senha ficam só na Vercel.
#
# Variável nova exige BUILD NOVO. Republicar um deploy antigo herda o snapshot
# de variáveis e não enxerga valor novo.

# --- Medição do site (Parte 1 e 2) -------------------------------------------
# ID de medição do Google Analytics 4 (formato G-XXXXXXXXXX). Público por
# natureza: vai para o navegador. Serve para MEDIR.
# Ambientes: Production e Preview.
NEXT_PUBLIC_SITE_INDEXAVEL=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Leitura dos relatórios no painel (Parte 3.3) ----------------------------
# Número da propriedade do GA4, só os dígitos, sem "properties/". Serve para
# LER os relatórios — é diferente do G- acima.
# Ambiente: Production.
GA4_PROPERTY_ID=

# JSON inteiro da conta de serviço com papel de leitora no Analytics.
# Cadastrar como Secret, sem editar o conteúdo do arquivo.
# Ambiente: Production.
GA4_CREDENCIAIS=

# --- Painel administrativo (Parte 3.1 e 3.2) ---------------------------------
# Texto aleatório com 32 caracteres ou mais, usado para assinar o cookie de
# sessão. Trocar esta variável derruba todas as sessões abertas. Secret.
ADMIN_SESSION_SECRET=

# OPCIONAL. Senha inicial da conta semente (marcos@softaliza.com.br), criada
# sozinha na primeira execução quando não há conta nenhuma. Sem esta variável,
# a conta nasce sem senha e o primeiro acesso é pelo código enviado por e-mail.
# Secret.
ADMIN_SENHA_INICIAL=

# --- Armazenamento das contas (Parte 3.2) ------------------------------------
# Cadastradas automaticamente pela Vercel ao conectar um store do Vercel Blob
# ao projeto, em Storage. A Vercel usa BLOB_STORE_ID; projetos antigos têm
# BLOB_READ_WRITE_TOKEN. O painel aceita as duas.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# --- E-mail (formulário de leads e código de acesso ao painel) ---------------
# Já cadastradas neste projeto.
SENDGRID_API_KEY=
SENDGRID_EMAIL=

# OPCIONAL. Destinatários dos leads do formulário, separados por vírgula.
LEADS_EMAIL_PARA=
